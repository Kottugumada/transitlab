# Copy this to .env and fill in your values.
# Never commit .env to the repository.

# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Backyard prediction location (default: Morgan Hill, CA)
LOCATION_LAT=37.1305
LOCATION_LON=-121.6544
LOCATION_NAME=Morgan Hill, CA

# Hunt batch budget — maximum targets to process in a single hunt run
# Keep low during development; raise for production runs
HUNT_MAX_TARGETS=50
